# Copy to .env for local development. Never commit .env or share API keys.
# demo uses local simulations; live runs all three Evolus workflows and surfaces errors.
LEDGERHAWK_MODE=demo

EVOLUS_BASE_URL=https://api.evolus.ai
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_WORKFLOW_EXTRACT_ID=
EVOLUS_WORKFLOW_ASSESS_ID=
EVOLUS_WORKFLOW_ROUTE_ID=

# Display label only; set to the model connected to your Evolus workflows.
AMD_MODEL_NAME=AMD TokenFactory
