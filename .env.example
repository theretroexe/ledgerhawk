# Copy to .env and fill in. Any step whose IDs are missing runs in simulation.
# Evolus workspace -> API keys page
EVOLUS_API_KEY=
EVOLUS_APP_ID=
# Document extractor (agent that owns it + extractor id)
EVOLUS_EXTRACTOR_AGENT_ID=
EVOLUS_EXTRACTOR_ID=
# AP control agent, configured to use the AMD vLLM endpoint as its model
EVOLUS_AP_AGENT_ID=
# Workflows: approved -> post to ERP, everything else -> human review
EVOLUS_WORKFLOW_POST_ID=
EVOLUS_WORKFLOW_REVIEW_ID=
# Shown in the UI only
AMD_MODEL_NAME=Qwen2.5-7B-Instruct · vLLM on AMD Instinct MI300X
